# ─────────────────────────────────────────────────────────────────────────
# Frontend environment — copy to .env (or .env.local / .env.production etc.)
#
# The ENTIRE frontend resolves the backend base URL from this ONE variable
# (read only in src/api/client.js). Deployment = change this value; no code edits.
#
#   local       → http://localhost:5000
#   dev         → https://dev-api.yourdomain.com
#   staging     → https://staging-api.yourdomain.com
#   production  → https://api.yourdomain.com
#
# Value is the backend ORIGIN only (scheme + host + port), no trailing slash and
# no "/api" suffix — callers pass full paths beginning with "/api/...".
# If unset, the app falls back to http://localhost:5000 for local dev.
# ─────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
